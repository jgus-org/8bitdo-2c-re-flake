+static const enum power_supply_property xpad_battery_props[] = {
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_SCOPE,
+};
+
+static int xpad_battery_get_property(struct power_supply *psy,
+				    enum power_supply_property psp,
+				    union power_supply_propval *val)
+{
+	struct usb_xpad *xpad = power_supply_get_drvdata(psy);
+	u8 status = READ_ONCE(xpad->battery_level);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = min_t(int, status & 0x7f, 100);
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		val->intval = POWER_SUPPLY_SCOPE_DEVICE;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void xpad_battery_probe(struct usb_xpad *xpad)
+{
+	struct power_supply_desc *desc = &xpad->battery_desc;
+	struct power_supply_config cfg = { .drv_data = xpad };
+	struct power_supply *psy;
+
+	if (!(xpad->mapping & MAP_2C_RELAY))
+		return;
+
+	snprintf(xpad->battery_name, sizeof(xpad->battery_name), "xpad-%s",
+		 dev_name(&xpad->dev->dev));
+
+	desc->name = xpad->battery_name;
+	desc->type = POWER_SUPPLY_TYPE_BATTERY;
+	desc->properties = xpad_battery_props;
+	desc->num_properties = ARRAY_SIZE(xpad_battery_props);
+	desc->get_property = xpad_battery_get_property;
+
+	psy = power_supply_register(&xpad->intf->dev, desc, &cfg);
+	if (IS_ERR(psy)) {
+		dev_warn(&xpad->dev->dev,
+			 "unable to register power supply: %ld\n",
+			 PTR_ERR(psy));
+		xpad->battery = NULL;
+		return;
+	}
+
+	xpad->battery = psy;
+}
+
+static void xpad_battery_disconnect(struct usb_xpad *xpad)
+{
+	if (xpad->battery) {
+		power_supply_unregister(xpad->battery);
+		xpad->battery = NULL;
+	}
+}
+
 static void xpad_deinit_input(struct usb_xpad *xpad)
 {
 	if (xpad->input_created) {
 		xpad->input_created = false;
+		xpad_battery_disconnect(xpad);
 		xpad_led_disconnect(xpad);
 		input_unregister_device(xpad->dev);
 	}
